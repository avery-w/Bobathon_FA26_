{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Provenance Extension (open ~/prov-demo)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension",
        "${userHome}/prov-demo"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode-extension/dist/**/*.js"]
    }
  ]
}
