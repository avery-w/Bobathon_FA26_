{
  "name": "bob-time-machine-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Bob Time Machine: decisions, provenance, and cost in one cockpit",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:prov": "pnpm --filter \"./packages/**\" build",
    "build:web": "pnpm --filter bob-time-machine build",
    "test": "vitest run",
    "test:py": "python3 -m unittest discover -s apps/analytics/tests",
    "lint": "eslint .",
    "typecheck": "pnpm --filter \"./packages/**\" typecheck",
    "demo": "bash demo/build-demo.sh",
    "dev": "bash scripts/dev-all.sh"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
