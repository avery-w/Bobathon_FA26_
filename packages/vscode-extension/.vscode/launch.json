{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (open ~/prov-demo)",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "build-provenance-extension",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${userHome}/prov-demo"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    }
  ]
}
